# Tour request form delivery (Resend). Leave unset in development to see the fallback message.
RESEND_API_KEY=
CONTACT_TO_EMAIL=MSCMOfficeAssistant@gmail.com
CONTACT_FROM_EMAIL="MSCM Website <tours@montessoricentralmarin.org>"

# Admin publish -> git backup. Fine-grained GitHub token with Contents: read and write on this repo only.
# Leave unset to skip the git copy (publishing still works).
GITHUB_SYNC_TOKEN=
# Optional; defaults to the Vercel-connected repo (or jedmelnik/montessoricentralmarin) and main.
GITHUB_SYNC_REPO=
GITHUB_SYNC_BRANCH=
